{
  "meta": {
    "name": "ReinigungsRadar NRW directory taxonomy",
    "version": "2.0.0",
    "region": "Nordrhein-Westfalen",
    "country": "DE",
    "description": "Two separate directories: private-sector prospective customers and cleaning/security service providers."
  },
  "region": {
    "country": "Deutschland",
    "state": "Nordrhein-Westfalen",
    "allowed_nuts1_prefix": "DEA",
    "note": "Only companies with a verifiable NRW location or service area belong in the directory."
  },
  "directories": [
    {
      "id": "prospective_customers",
      "label": "Kundenverzeichnis",
      "description": "Private-sector organisations that may need cleaning or security services. Public tenders are not required.",
      "categories": [
        "Büro und Verwaltung", "Industrie und Produktion", "Lager und Logistik",
        "Einzelhandel und Einkaufszentren", "Hotel und Gastronomie",
        "Private Gesundheitsunternehmen", "Immobilienverwaltung",
        "Bildung und private Einrichtungen", "Freizeit und Veranstaltungsorte"
      ],
      "fields": [
        "Unternehmen", "Branche / Einrichtung", "Stadt", "PLZ", "Adresse",
        "Telefon", "E-Mail", "Website", "Reinigungsbedarf", "Security-Bedarf",
        "Quelle", "Quellenlink", "Prüfdatum", "Datenstatus", "Notizen"
      ]
    },
    {
      "id": "service_providers",
      "label": "Anbieter-Verzeichnis",
      "description": "Companies that provide cleaning or security services, for supplier mapping, partnerships and market research.",
      "categories": {
        "Reinigung": [
          "Gebäudereinigung", "Büroreinigung", "Unterhaltsreinigung",
          "Glasreinigung", "Industriereinigung", "Grundreinigung", "Sonderreinigung"
        ],
        "Security": [
          "Sicherheitsdienst", "Objektschutz", "Empfangsdienst",
          "Revierdienst", "Veranstaltungssicherheit", "Zutrittskontrolle"
        ]
      },
      "fields": [
        "Unternehmen", "Dienstleistung", "Stadt", "PLZ", "Adresse",
        "Telefon", "E-Mail", "Website", "Einsatzgebiet",
        "Zertifikate / Erlaubnisse", "Quelle", "Quellenlink",
        "Prüfdatum", "Datenstatus", "Notizen"
      ]
    }
  ],
  "rules": {
    "procurement_required": false,
    "automatic_outreach": false,
    "public_contact_data_is_marketing_consent": false,
    "deduplication_key": ["Unternehmen", "PLZ", "Website"],
    "data_quality_statuses": ["Zu prüfen", "Teilweise bestätigt", "Bestätigt", "Veraltet"],
    "source_and_review_date_required": true,
    "no_invented_contact_details": true
  }
}
